// Cloudflare Workers static assets: the prerendered site in dist/, no Worker
// code. Pushes to main deploy through GitHub Actions (.github/workflows/ci.yml);
// `npm run deploy:cloudflare` still deploys from this machine. Response headers live in
// public/_headers. The /api/waitlist function is Vercel-only and is not
// deployed here; the waiting list is switched off anyway.
{
  "name": "tinypercent",
  "compatibility_date": "2026-09-01",
  // Custom domains: Cloudflare creates the DNS records and certificates.
  "routes": [
    { "pattern": "tinypercent.com", "custom_domain": true },
    { "pattern": "www.tinypercent.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    // /privacy serves privacy.html.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application"
  }
}
